{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.2.2",
  "identifier": "org.ember.signals.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ember",
        "width": 1040,
        "height": 850,
        "minWidth": 580,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'; img-src 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/ember-worker"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFMDQwODUxMEM5RDBFQkMKUldTOERwME1VUWdFTHR1cDI3Z0VWZFRCUUxmQWErZEx0Q3kyT1k5M0puZ2RmWXEvUXU3Wmg2TGgK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
